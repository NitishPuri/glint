#version 460
#include "glint.glsl"
#include "common.glsl"

// Pass 1: one invocation per point, flag = inside the star. The scan input (level 0) starts as the flags.

layout(local_size_x = 256) in;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.counts.x) return;
  uint flag = inside(pointPosition(i, pc.counts.w, pc.counts.x), pc.params.x) ? 1u : 0u;
  flags[i] = flag;
  data[i] = flag;
}
