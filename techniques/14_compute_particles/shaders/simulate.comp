#version 460
#include "glint.glsl"

// One invocation per particle: read it from the storage buffer, integrate one time step, write it back in
// place. No particle reads another, so in-place update is safe (no ping-pong buffers needed). That changes
// with interactions (28_nbody_boids).

layout(local_size_x = 256) in;  // = kWorkgroupSize. 256 threads per group: a multiple of AMD's 64-wide and
                                // NVIDIA's 32-wide hardware threads (wave / warp).

struct Particle {
  vec4 position;  // xyz, w = age (s); < 0: not born yet
  vec4 velocity;  // xyz, w = lifetime (s)
};

// GL: glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, ...). VK: a STORAGE_BUFFER descriptor at set 0, binding 0.
SSBO(0, 0) Particles {
  Particle particles[];  // runtime-sized: the length comes from the bound buffer range
};

PUSH_CONSTANTS Sim {
  vec4 time;    // x = dt, y = simulation time, z = 1: reset, w = active count
  vec4 forces;  // x = gravity, y = attractor strength, z = damping, w = bounce
  vec4 emit;    // x = launch speed
} pc;

// PCG hash (Jarzynski & Olano, "Hash Functions for GPU Rendering", JCGT 2020): integer in, well-mixed integer
// out. Stateless randomness: a particle's index + a per-respawn salt is all it needs, and it's bit-identical
// in GL and VK.
uint pcg(uint v) {
  uint state = v * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}
float random01(inout uint seed) {
  seed = pcg(seed);
  return float(seed) * (1.0 / 4294967296.0);
}

const vec3 kEmitter = vec3(0.0, 0.1, 0.0);

void spawn(inout Particle p, uint seed) {
  // A fountain: a cone around +Y, 25 degrees wide.
  float phi = 6.2831853 * random01(seed);
  float cosTheta = mix(cos(radians(25.0)), 1.0, random01(seed));
  float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
  vec3 dir = vec3(sinTheta * cos(phi), cosTheta, sinTheta * sin(phi));
  float speed = pc.emit.x * mix(0.8, 1.2, random01(seed));
  p.position.xyz = kEmitter + 0.05 * (vec3(random01(seed), random01(seed), random01(seed)) - 0.5);
  p.velocity = vec4(dir * speed, mix(3.0, 6.0, random01(seed)));
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  // The last workgroup can run past the end: dispatches come in whole groups of 256.
  if (i >= uint(pc.time.w)) return;

  Particle p = particles[i];
  float dt = pc.time.x;

  if (pc.time.z > 0.5) {  // reset: new particle, born at a random moment in the next 3 s
    spawn(p, i * 2u + 1u);
    uint seed = i * 2u;  // a different seed than spawn's (even vs. odd)
    p.position.w = -3.0 * random01(seed);
    particles[i] = p;
    return;
  }

  p.position.w += dt;
  if (p.position.w < 0.0) {  // not born yet
    particles[i] = p;
    return;
  }
  if (p.position.w >= p.velocity.w) {  // died: respawn, keeping the overshoot so emission stays continuous
    float age = p.position.w - p.velocity.w;
    spawn(p, i ^ pcg(floatBitsToUint(pc.time.y)));
    p.position.w = age;
  }

  // Forces: gravity, two attractors orbiting the fountain (softened inverse square), drag.
  float t = pc.time.y;
  vec3 attractors[2] = vec3[2](vec3(2.5 * cos(0.7 * t), 2.5, 2.5 * sin(0.7 * t)),
                               vec3(-2.0 * cos(0.45 * t), 1.5 + 0.8 * sin(0.9 * t), -2.0 * sin(0.45 * t)));
  vec3 accel = vec3(0.0, -pc.forces.x, 0.0);
  for (int a = 0; a < 2; ++a) {
    vec3 d = attractors[a] - p.position.xyz;
    float r2 = dot(d, d) + 0.25;
    accel += pc.forces.y * d * inversesqrt(r2 * r2 * r2);
  }
  vec3 v = p.velocity.xyz + accel * dt;
  v *= exp(-pc.forces.z * dt);
  vec3 x = p.position.xyz + v * dt;  // semi-implicit Euler: new velocity, then position

  if (x.y < 0.0) {  // the floor
    x.y = -x.y * pc.forces.w;
    v.y = -v.y * pc.forces.w;
    v.xz *= 0.8;
  }
  p.position.xyz = x;
  p.velocity.xyz = v;
  particles[i] = p;
}
